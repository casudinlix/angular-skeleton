{
  "$schema": "http://json-schema.org/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "Feature name in kebab-case",
      "x-prompt": "Feature name"
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}
